# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
# Comma-separated list, do not remove localhost/127.0.0.1 for development
DJANGO_ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver

# CORS - comma separated list of allowed origins
# Include local dev and preview URLs as needed
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,https://127.0.0.1:3000

# REST Framework
DRF_PAGE_SIZE=20

# Database (PostgreSQL) - defaults target database container at port 5001
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_HOST=127.0.0.1
DB_PORT=5001
DB_CONN_MAX_AGE=60

# Optional DB options
# DB_SSLMODE=prefer
