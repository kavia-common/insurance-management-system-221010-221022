# Base URL for the backend API. Include trailing slash not required; client will handle joining.
REACT_APP_API_BASE=http://localhost:8000/api

# Web app site URL (used for redirects if needed)
REACT_APP_SITE_URL=http://localhost:3000

# Optional: Separate explicit resource endpoints (if client uses them)
REACT_APP_CUSTOMERS_URL=http://localhost:8000/api/customers
REACT_APP_POLICIES_URL=http://localhost:8000/api/policies
REACT_APP_CLAIMS_URL=http://localhost:8000/api/claims
REACT_APP_HEALTH_URL=http://localhost:8000/api/health
